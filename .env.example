# Copy to .env.local and fill in. Never commit real values.

# Supabase: Dashboard > Project Settings > API (or `npx supabase status` locally).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose it to the browser, never prefix it with NEXT_PUBLIC_.
# Used by scripts/make-admin.ts and, at runtime, by the app server for the few
# things a browser session may not do: saving link previews and moving an order
# between statuses (lib/orders/state-machine.ts). Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Protects /api/cron/fx (the exchange-rate fetch). Use a long random
# value, for example `openssl rand -hex 32`. Set the same value in Vercel; Vercel
# sends it as `Authorization: Bearer <value>` when it calls the cron. Without it
# the route answers 401 to everyone.
CRON_SECRET=

# Public URL of this app, used in auth email links.
# Add <this URL>/auth/callback under Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Set to "true" after enabling the Google provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Only needed for the local Supabase CLI stack (read by supabase/config.toml).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

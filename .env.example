# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard > Project Settings > API, or `npx supabase status` locally).
# The legacy "anon" key also works as the publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used by scripts/grant-admin.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in auth email links and OAuth redirects.
# Add <this URL>/auth/callback to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in. Set to "true" after enabling the Google provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Only needed for the local Supabase CLI stack (read by supabase/config.toml).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
